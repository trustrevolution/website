{{- /*
  Podcast RSS feed — the one Apple Podcasts and Spotify poll.

  This replaces the Fountain-hosted feed. Three things in here are load-bearing
  and must not be "tidied":

  1. Item <guid> and <pubDate> come from front matter, carried verbatim out of
     the archived Fountain feed. Regenerating either republishes all 37 episodes
     to every subscriber as new.
  2. <podcast:guid> is the show's permanent identity. Podcast Index uses it to
     recognise this feed as the same show, which is the only recovery path for
     subscribers who followed the raw Fountain URL and have no redirect.
  3. <enclosure length> is the true byte size from the archive, not Fountain's
     declared value, which is rounded on MP3s derived from video masters.

  Audio-only by design: video lives on episode pages, not in the feed. See KTD3
  in docs/plans/2026-08-01-001-feat-fountain-to-r2-migration-plan.md.
*/ -}}
{{- $site := .Site -}}
{{- $pod := $site.Params.podcast -}}
{{- $media := $site.Params.media_base -}}
{{- $episodes := where $site.RegularPages "Section" "episodes" -}}
{{- $episodes = where $episodes "Params.guid" "!=" nil -}}
{{- $episodes = sort $episodes "Params.episode" "desc" -}}
{{- $episodes = sort $episodes "Params.season" "desc" -}}
{{- printf "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:itunes="http://www.itunes.com/dtds/podcast-1.0.dtd" xmlns:podcast="https://podcastindex.org/namespace/1.0">
  <channel>
    <title>{{ $site.Title }}</title>
    <link>{{ $site.BaseURL }}</link>
    <description>{{ $site.Params.description }}</description>
    <language>{{ $pod.language | default "en" }}</language>
    <generator>Hugo</generator>
    <atom:link href="{{ $site.Params.podcast_rss_url }}" rel="self" type="application/rss+xml" />
    <itunes:author>{{ $site.Params.author }}</itunes:author>
    <itunes:explicit>{{ if $pod.explicit }}true{{ else }}false{{ end }}</itunes:explicit>
    <itunes:type>episodic</itunes:type>
    <itunes:image href="{{ $media }}/{{ $pod.cover_art }}" />
    {{- with $pod.owner_email }}
    <itunes:owner>
      <itunes:name>{{ $pod.owner_name }}</itunes:name>
      <itunes:email>{{ . }}</itunes:email>
    </itunes:owner>
    {{- end }}
    {{- range $pod.itunes_categories }}
    {{- if .sub }}
    <itunes:category text="{{ .text | safeHTML }}">
      <itunes:category text="{{ .sub | safeHTML }}" />
    </itunes:category>
    {{- else }}
    <itunes:category text="{{ .text | safeHTML }}" />
    {{- end }}
    {{- end }}
    <podcast:guid>{{ $pod.guid }}</podcast:guid>
    <podcast:medium>podcast</podcast:medium>
    {{- with $pod.funding_url }}
    <podcast:funding url="{{ . }}">{{ $pod.funding_text }}</podcast:funding>
    {{- end }}
    {{- with $pod.value_recipients }}
    <podcast:value type="lightning" method="lnaddress">
      {{- range . }}
      <podcast:valueRecipient name="{{ .name }}" split="{{ .split }}" type="lnaddress" address="{{ .address }}" />
      {{- end }}
    </podcast:value>
    {{- end }}
    {{ range $episodes }}
    {{- $slug := .Params.slug | default .File.ContentBaseName -}}
    <item>
      <title>{{ .Title }}</title>
      <link>{{ .Permalink }}</link>
      <guid isPermaLink="false">{{ .Params.guid }}</guid>
      <pubDate>{{ .Params.feed_pubdate | safeHTML }}</pubDate>
      <description>{{ with .Params.description }}{{ . }}{{ else }}{{ .Summary | plainify }}{{ end }}</description>
      {{- /* Episode 0 is the trailer. Tested against nil rather than with
             `with`, which treats 0 as empty and would drop it silently. */ -}}
      <itunes:episodeType>{{ if eq .Params.episode 0 }}trailer{{ else }}full{{ end }}</itunes:episodeType>
      <itunes:explicit>{{ if $pod.explicit }}true{{ else }}false{{ end }}</itunes:explicit>
      <enclosure url="{{ .Params.audio_url }}" length="{{ .Params.enclosure_bytes }}" type="audio/mpeg" />
      {{- with .Params.duration_seconds }}
      <itunes:duration>{{ . }}</itunes:duration>
      {{- end }}
      {{- with .Params.season }}
      <itunes:season>{{ . }}</itunes:season>
      <podcast:season>{{ . }}</podcast:season>
      {{- end }}
      {{- with .Params.episode }}
      <itunes:episode>{{ . }}</itunes:episode>
      <podcast:episode>{{ . }}</podcast:episode>
      {{- end }}
      <itunes:image href="{{ $media }}/art/{{ $slug }}.jpg" />
      {{- with .Params.chapters_url }}
      <podcast:chapters url="{{ . }}" type="application/json+chapters" />
      {{- end }}
      {{- with .Params.transcript_url }}
      <podcast:transcript url="{{ . }}" type="application/x-subrip" rel="captions" />
      {{- end }}
    </item>
    {{- end }}
  </channel>
</rss>
